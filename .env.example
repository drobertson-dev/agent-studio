# Caddy listens for the admin app and all published site hostnames.
# Use :80 behind a platform proxy. Set exact hostnames for direct public Caddy/ACME.
# Wildcard HTTPS requires an external wildcard TLS layer or Caddy DNS challenge support.
APP_DOMAIN=:80
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
ADMIN_HOST_REGEX=^(localhost|127\.0\.0\.1|admin\.localhost|admin\.agent-studio\.orb\.local|admin\..+)(:\d+)?$

# Studio login for the Nuxt UI. Change this before running a shared deployment.
STUDIO_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-secret

# Host-based publishing. admin.* routes to the studio; other matching hosts route to sites.
ADMIN_HOSTS=localhost,127.0.0.1,admin.localhost,admin.agent-studio.orb.local
SITE_DOMAIN_SUFFIXES=localhost,agent-studio.orb.local
DEFAULT_SITE=
DEFAULT_SITE_HOSTS=

# Runtime persistence.
POSTGRES_USER=langgraph
POSTGRES_PASSWORD=change-me
POSTGRES_DB=langgraph

# LLM provider. Keep one provider key populated for the selected model.
DEFAULT_AGENT_MODEL=anthropic:claude-opus-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
