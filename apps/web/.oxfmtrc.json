{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "singleAttributePerLine": true,
  "experimentalTailwindcss": {
    "functions": ["cn", "clsx"],
    "stylesheet": "app/assets/css/tailwind.css"
  },
  "ignorePatterns": [
    "node_modules/",
    ".pnp",
    ".pnp.js",
    ".nuxt/",
    ".output/",
    ".nitro/",
    "dist/",
    "build/",
    "static/",
    "public/",
    ".nuxt-analyze/",
    "coverage/",
    ".agents/",
    "*.log",
    "*.tgz",
    "*.tar.gz",
    ".vscode/",
    ".idea/",
    "*.swp",
    "*.swo",
    ".DS_Store",
    ".DS_Store?",
    "._*",
    ".Spotlight-V100",
    ".Trashes",
    "ehthumbs.db",
    "Thumbs.db",
    ".env",
    ".env.local",
    ".env.*.local",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "README.md",
    ".agents/ref_docs/**"
  ]
}
